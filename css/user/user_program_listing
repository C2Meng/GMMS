/* =========================================================
   Program / Book Class Specific Styles
   ========================================================= */

/* Make the program link cards slightly interactive */
.program-link {
    display: block;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.program-link:hover .program-card {
    transform: translateY(-2px);
    box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important; 
}

/* Card Structure */
.program-card {
    overflow: hidden; /* Ensures the top image corners stay rounded */
    background-color: #ffffff;
    min-height: 240px; /* Gives the card a solid base height */
}

/* Base Image Container */
.program-image {
    width: 100%;
    height: 160px; /* Fixed height for consistency across all cards */
    border-bottom: 1px solid #dee2e6;
}

/* Unique Images for Each Program */
.bg-program-1 {
    background: url('../images/program-1.jpg') no-repeat center center;
    background-size: cover;
}

.bg-program-2 {
    background: url('../images/program-2.jpg') no-repeat center center;
    background-size: cover;
}

.bg-program-3 {
    background: url('../images/program-3.jpg') no-repeat center center;
    background-size: cover;
}